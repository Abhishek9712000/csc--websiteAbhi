# Copy this file to .env and fill in your real values. Never commit .env to git.

# MongoDB connection string. Use MongoDB Atlas (free tier) if you don't have your own DB.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/csc-website

# Any long random string, used to sign admin login tokens
JWT_SECRET=MayankDigitalStudio@2026!SecretKey

# Port the backend server runs on
PORT=5000

# Owner's UPI ID shown to customers for payment (e.g. yourshopname@okhdfcbank)
UPI_ID=ashish.8574@ptyes
UPI_PAYEE_NAME=MayankDigitalStudio

# Frontend URL, used for CORS
FRONTEND_URL=http://localhost:5173
